{
  "_doc": {
    "zone": "All local date-times are America/New_York wall-clock ISO strings without an offset (earlier offset on a fall-back ambiguity). Epoch values are milliseconds.",
    "keys": "KEY = RULE ( \"@\" HHMM | \"_h\" H ), RULE = D0-6 | W1-4 | Wd1-7 | Wn1-7 | Dom1 | Dom15 | DomL | Mo1-3, HHMM = local wall-clock time rounded to 5 minutes, H = 0-12. Regex: ^(D[0-6]|W[1-4]|Wd[1-7]|Wn[1-7]|Dom1|Dom15|DomL|Mo[1-3])(@([01]\\d|2[0-3])[0-5][05]|_h([0-9]|1[0-2]))$",
    "extract": "extractKeys(at, target): keys sorted by code unit; setId = keys joined by \"__\", or null when there are no keys.",
    "quickCredit": "The quick-time slot (HHMM) a commit credits, or null when it credits none: a same-snooze-day commit, or a suggestion whose picked key is an hours offset.",
    "resolve": "resolveKey(key, now) -> epochLocal, or null when it can't resolve more than 60s into the future.",
    "labelDist": "Label day phrase for key resolved at resolvedLocal from now. dist = max(0, snoozeDay(resolved) - calendarDate(now)); weekday = ISO weekday of snoozeDay(resolved); phrase is one of today|tomorrow|inDays|inWeeks|this|next|inTwoWeeks|calendar; family is the key's date-rule family; region (timed keys only) is the time-of-day name of the resolved time.",
    "labelOffset": "Same-day hours-offset label kind: littleWhile for up to 3 hours, muchLater beyond.",
    "quickTimes": "quickTimes(partitions, now): each partition is a wire `tod` map; expect lists the chosen clockMinutes (minutes after local midnight) in clock order.",
    "rank": "rank(partitions, now): each partition is a wire partition; expectKeys are the chosen rows' keys in row (time) order.",
    "wire": "fromWire(raw) must equal normalized, and toWire(fromWire(raw)) must equal normalized."
  },
