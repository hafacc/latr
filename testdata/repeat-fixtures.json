  "_doc": {
    "repeat": "{every: 1..7, unit: day|week|month, weekday: ISO weekday 1..7 (Monday=1, used by week), monthDay: 1..31 or -1 for the last day (used by month; a day past the month's end lands on its last day), at: HH:MM, anchor: YYYY-MM-DD}",
    "next": "The first occurrence strictly after `after` (local date-time, no zone). Every N days counts days from the anchor; every N weeks counts Monday-start weeks from the anchor's week; every N months counts months from the anchor's month.",
    "anchor": "The anchor a rule saved at `now` gets: the date of its first occurrence after `now`, counting as if every were 1.",
    "text": "The repeating row's second line."
  },
