<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. The snooze identity must not follow a backup or transfer to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="snooze_identity.xml" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.hafaio-latr.%28default%29" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.hafaio-latr.%28default%29-journal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.hafaio-latr.%28default%29-wal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.hafaio-latr.%28default%29-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="snooze_identity.xml" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.hafaio-latr.%28default%29" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.hafaio-latr.%28default%29-journal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.hafaio-latr.%28default%29-wal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.hafaio-latr.%28default%29-shm" />
    </device-transfer>
</data-extraction-rules>
