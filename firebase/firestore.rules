rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /todos/{todoId} {
        allow read, create, delete: if request.auth != null
          && request.auth.uid == userId;

        // Writes must not move serverModifiedAt back. Every client write stamps
        // serverTimestamp() and passes; docs without the field get one free pass.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && (!('serverModifiedAt' in resource.data)
              || request.resource.data.serverModifiedAt >= resource.data.serverModifiedAt);
      }
    }

    // Global pick-rank tally: admins read; writes move one field by exactly ±1.
    // `key` names that field, since rules can't pull it out of affectedKeys().
    match /snoozePickLog/{docId} {
      function validBump(before) {
        let k = request.resource.data.key;
        let changed = request.resource.data.diff(before).affectedKeys();
        return k is string
          && k.matches('[1-9]|1[0-9]|20|none')
          && changed.hasOnly([k, 'key'])
          && changed.hasAny([k])
          && request.resource.data[k] is int
          && (request.resource.data[k] == before.get(k, 0) + 1
              || request.resource.data[k] == before.get(k, 0) - 1);
      }

      allow create: if request.auth != null && docId == 'global' && validBump({});
      allow update: if request.auth != null && docId == 'global' && validBump(resource.data);
      allow read: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
